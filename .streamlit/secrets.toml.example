# Replace the placeholder in your PRIVATE secrets.toml, never in this example.
[groq]
api_key = "YOUR_GROQ_API_KEY"

# Optional secure sign-in with Streamlit OpenID Connect.
# Uncomment and fill every value in your PRIVATE secrets.toml only.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
# client_id = "YOUR_IDENTITY_PROVIDER_CLIENT_ID"
# client_secret = "YOUR_IDENTITY_PROVIDER_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional account history and saved profile storage. Keep this key private;
# use a Supabase server secret key, never a publishable key.
# [supabase]
# url = "https://YOUR_PROJECT_REF.supabase.co"
# secret_key = "sb_secret_YOUR_SERVER_KEY"
